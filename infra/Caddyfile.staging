:80 {
	encode gzip
	# Keep Report-Only in staging for ongoing CSP testing before promoting to enforced prod.
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' ws: wss: http: https:; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://tile.openstreetmap.org; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	handle /intel/* {
		reverse_proxy mirror-intel:8120
	}
	handle /healthz {
		reverse_proxy mirror-intel:8120
	}
	handle {
		reverse_proxy frontend:80
	}
}
