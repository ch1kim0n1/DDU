# DDU dev environment defaults. Copy to .env and override.
NEO4J_PASSWORD=ddudevpass
MINIO_ROOT_USER=dduadmin
MINIO_ROOT_PASSWORD=ddudevpass
COMPREFACE_POSTGRES_PASSWORD=postgres
MARQUEZ_DB_USER=marquez
MARQUEZ_DB_PASSWORD=marquez
MARQUEZ_PORT=5002
MIRROR_REDIS_PASSWORD=ddudevpass
MIRROR_REDIS_PORT=6379

# Auth (dev mints HS256 JWTs via POST /v1/auth/dev-token)
AUTH_MODE=dev
DDU_JWT_SECRET=ddu-dev-jwt-secret-change-me
DDU_ALLOW_ROLE_HEADER=true
DDU_AUDIT_ENABLED=false

# ML: stub by default; set real only after weights + optional deps are installed
MODEL_MODE=stub
