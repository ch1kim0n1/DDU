# Mirror intelligence API base URL (no trailing slash).
# Leave empty when the UI is served behind the same origin (Caddy/nginx proxy).
VITE_MIRROR_API_URL=http://localhost:8120

# Allow mock seeding from the UI (dev/demo only). Ignored when backend is in production mode.
VITE_MIRROR_SEED_MOCKS=true

# Sentry DSN for frontend error tracking (optional). Exposed to the browser — use a public DSN only.
VITE_SENTRY_DSN=
