# ddu-mirror-intel (Engineer B) — environment
#
# Copy to .env and fill in. The service runs WITHOUT any of these — it falls
# back to a deterministic LLM provider and cached discovery data, and
# discloses both in its responses. Nothing here is required to demo.
#
#   cp services/ddu-mirror-intel/.env.example services/ddu-mirror-intel/.env
#
# .env is already gitignored at the repo root. Never commit real keys.


# ─────────────────────────────────────────────────────────────────────────
# 1. ANTHROPIC_API_KEY — free tier available, needed for real model output
# ─────────────────────────────────────────────────────────────────────────
# Used by: remediation copy (persona-specific "why this matters to you"),
#          public-records prioritization, quarantined bio parsing.
#
# WITHOUT IT: the offline provider answers, every affected response carries
# `offline: true`, and the UI must label it. Findings, severity, scoring,
# attack paths, and reversibility are all computed locally and stay correct.
#
# Get one: https://console.anthropic.com/settings/keys
# Alternative: `ant auth login` stores a profile the SDK reads automatically,
# with no env var set. Check with `ant auth status`.
ANTHROPIC_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
# 2. HIBP_API_KEY — PAID, and the one to sort out first
# ─────────────────────────────────────────────────────────────────────────
# Used by: breach discovery (discovery/hibp.py).
#
# The `breachedaccount` endpoint is NOT free — it needs a paid subscription.
# The spec flags confirming this in hour zero, and it is the single most
# time-sensitive item on this list: discovering it at hour eighteen is how a
# demo loses its most visceral finding.
#
# WITHOUT IT: cached demo breach data is served instead, and every finding
# says method="HIBP cached demo data (disclosed)". That is a fine demo — just
# say so on stage. Nobody penalizes disclosed cached data; being caught
# passing it off as live is a different matter.
#
# Get one: https://haveibeenpwned.com/API/Key (monthly, low cost — confirm
# current tiers and rate limits before relying on them mid-demo).
HIBP_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
# Optional — not keys, just knobs
# ─────────────────────────────────────────────────────────────────────────

# Force the deterministic provider even when a key is present. Set this for
# the live demo if you want zero network dependency on stage.
# MIRROR_FORCE_OFFLINE=1

# HMAC secret for evidence reveal tokens. Redis deployments automatically
# derive a shared HMAC key from MIRROR_SESSION_ENCRYPTION_KEY. Set this only
# when reveal-token rotation must be managed independently.
# MIRROR_REVEAL_SECRET=

# Path to Engineer A's persona weight matrix, shape {persona: {finding_type:
# multiplier}}. Overlays the built-in defaults; a partial matrix is fine.
# MIRROR_PERSONA_WEIGHTS=./persona-weights.json

# Port. Default 8120.
# MIRROR_INTEL_PORT=8120

# Environment: development | staging | production
# production disables mock seeding, swagger, and forces identity required.
# MIRROR_ENV=development

# Abuse controls (session create 5/hour/IP, voice 10/session, vision 5/session,
# approve 20/session, 3 concurrent WebSockets/IP). Set to 0 in automated tests.
# MIRROR_RATE_LIMIT=1

# CORS allowlist for the Mirror UI. Default allows local Vite/dev servers.
# In production set this to your exact frontend origin, e.g. ^https://mirror\.example\.com$
# MIRROR_UI_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# CompreFace face recognition service URL (optional, for vision)
# COMPREFACE_URL=http://compreface:8080
# CompreFace API key (optional, for vision)
# COMPREFACE_API_KEY=

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=

# Durable production sessions and LangGraph checkpoints. Redis state is
# encrypted client-side before it leaves this service. Generate a 32-byte
# URL-safe base64 key with your secrets manager and never commit it.
# MIRROR_REDIS_URL=redis://:ddudevpass@localhost:6379/0
# MIRROR_SESSION_ENCRYPTION_KEY=
# MIRROR_SESSION_TTL_SECONDS=1800
#
# Optional durable local checkpoint file when Redis is not configured.
# Session data remains in memory in this mode; only redacted workflow
# checkpoints are written here.
# MIRROR_CHECKPOINT_DB=.mirror/checkpoints.sqlite3

# Production identity gate. The bearer token supplied to POST /intel/session
# is verified against this issuer/audience; identifier request-body fields are
# ignored. Use JWKS for OIDC, or HS256 only for an internal signed assertion.
# MIRROR_IDENTITY_REQUIRED=1
# MIRROR_IDENTITY_ISSUER=https://identity.example.com/
# MIRROR_IDENTITY_AUDIENCE=ddu-mirror
# MIRROR_IDENTITY_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# MIRROR_IDENTITY_ALGORITHMS=RS256,ES256
# MIRROR_IDENTITY_HS256_SECRET=
# MIRROR_IDENTITY_EMAIL_CLAIM=email
# MIRROR_IDENTITY_EMAIL_VERIFIED_CLAIM=email_verified
# MIRROR_IDENTITY_HANDLE_CLAIM=preferred_username
# MIRROR_IDENTITY_ACCOUNT_URLS_CLAIM=account_urls

# Fail readiness and refuse cached discovery/browser voice fallbacks when a
# deployment promises fully live providers.
# MIRROR_REQUIRE_LIVE_PROVIDERS=1
# MIRROR_SHERLOCK_LIVE=1
# MIRROR_REQUIRE_ELEVENLABS=1
# MIRROR_VOICE_MAX_AUDIO_BYTES=8388608

# Engineer D voice layer. The UI still supports typed questions and browser
# speech synthesis without these values; microphone STT requires the API key,
# and ElevenLabs TTS additionally requires a voice id.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2


# ─────────────────────────────────────────────────────────────────────────
# NOT Engineer B's — do not put these here
# ─────────────────────────────────────────────────────────────────────────
# ElevenLabs (STT/TTS) ........ configured above by Engineer D
# Resend / SendGrid ........... Engineer A, email verification loop
# OAuth client credentials .... Engineer A, identity gate
# CompreFace .................. Engineer C — self-hosted via Docker, no key
